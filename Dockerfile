# syntax=docker/dockerfile:1
#
# guerd(1) as a container: the static site served by unprivileged nginx.
#   - the build stage always runs on the build platform, so multi-arch images
#     (linux/amd64, linux/arm64) need no emulation: the runtime stage only copies files;
#   - runs as uid 101, works with a read-only root filesystem (/tmp is the only
#     writable path), exposes 8080, answers /healthz.

ARG NODE_VERSION=24

FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine AS build
WORKDIR /src
ENV npm_config_fund=false \
    npm_config_audit=false \
    npm_config_update_notifier=false
COPY package.json package-lock.json ./
# Only the four build dependencies are needed here; QA tooling lives in devDependencies.
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --ignore-scripts
COPY content ./content
COPY scripts ./scripts
COPY src ./src
ARG SITE_URL=http://localhost:8080/
ARG GITHUB_REPOSITORY=louane20/portfolio
ARG SOURCE_DATE_EPOCH
RUN SITE_URL="$SITE_URL" GITHUB_REPOSITORY="$GITHUB_REPOSITORY" SOURCE_DATE_EPOCH="$SOURCE_DATE_EPOCH" \
    node scripts/build.mjs

FROM nginxinc/nginx-unprivileged:1.31-alpine-slim
COPY deploy/docker/default.conf /etc/nginx/conf.d/default.conf
# Generated by the build so the Content-Security-Policy hash matches the inline script.
COPY --from=build /src/build/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /src/dist /usr/share/nginx/html
USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
