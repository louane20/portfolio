{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://louane20.github.io/portfolio/schema/profile.json",
  "title": "Portfolio content",
  "description": "Schema for content/profile.yaml. Every translatable field must exist in English and French.",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "person", "glance", "about", "expertise", "experience", "education", "research", "projects", "credentials", "blog", "contact"],
  "$defs": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "fr", "ar"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "fr": { "type": "string", "minLength": 1 },
        "ar": { "type": "string", "minLength": 1 }
      }
    },
    "text": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/i18n" }
      ]
    },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "month": {
      "oneOf": [
        { "type": "integer", "minimum": 1990, "maximum": 2100 },
        { "type": "string", "pattern": "^(19|20)\\d{2}(-(0[1-9]|1[0-2]))?$" }
      ]
    },
    "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading"],
      "properties": {
        "heading": { "$ref": "#/$defs/i18n" },
        "intro": { "$ref": "#/$defs/i18n" }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "issuer", "date"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "issuer": { "type": "string" },
        "date": { "$ref": "#/$defs/month" }
      }
    }
  },
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "title", "description", "url", "repository", "resume"],
      "properties": {
        "command": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "$ref": "#/$defs/i18n" },
        "description": {
          "allOf": [
            { "$ref": "#/$defs/i18n" },
            { "type": "object", "properties": { "en": { "type": "string", "maxLength": 200 }, "fr": { "type": "string", "maxLength": 220 } } }
          ]
        },
        "url": { "$ref": "#/$defs/url" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
        "resume": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.pdf$" }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "given_name", "family_name", "role", "headline", "employer", "location", "timezone", "email", "links", "availability", "languages"],
      "properties": {
        "name": { "type": "string" },
        "given_name": { "type": "string" },
        "family_name": { "type": "string" },
        "role": { "$ref": "#/$defs/i18n" },
        "headline": { "$ref": "#/$defs/i18n" },
        "employer": { "type": "string" },
        "location": { "$ref": "#/$defs/i18n" },
        "timezone": { "type": "string", "pattern": "^[A-Za-z]+/[A-Za-z_]+$" },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$" },
        "phone": { "type": "string", "pattern": "^\\+[0-9 ]{8,20}$" },
        "phone_display": { "enum": ["hidden", "reveal", "visible"] },
        "photo": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._-]+\\.(jpe?g|png|webp|avif)$" },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["github", "linkedin"],
          "properties": {
            "github": { "$ref": "#/$defs/url" },
            "linkedin": { "$ref": "#/$defs/url" }
          }
        },
        "availability": { "$ref": "#/$defs/i18n" },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "level"],
            "properties": { "name": { "$ref": "#/$defs/i18n" }, "level": { "$ref": "#/$defs/i18n" } }
          }
        }
      }
    },
    "glance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "$ref": "#/$defs/i18n" },
          "value": { "$ref": "#/$defs/text" },
          "note": { "$ref": "#/$defs/text" }
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "paragraphs", "community"],
      "properties": {
        "heading": { "$ref": "#/$defs/i18n" },
        "paragraphs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/i18n" } },
        "community": {
          "type": "object",
          "additionalProperties": false,
          "required": ["heading", "items"],
          "properties": {
            "heading": { "$ref": "#/$defs/i18n" },
            "items": { "type": "array", "items": { "$ref": "#/$defs/i18n" } }
          }
        }
      }
    },
    "expertise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "areas"],
      "properties": {
        "heading": { "$ref": "#/$defs/i18n" },
        "intro": { "$ref": "#/$defs/i18n" },
        "areas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "text", "production"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "$ref": "#/$defs/i18n" },
              "text": { "$ref": "#/$defs/i18n" },
              "production": { "$ref": "#/$defs/tools" },
              "other": { "$ref": "#/$defs/tools" }
            }
          }
        },
        "also": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "items"],
            "properties": { "label": { "$ref": "#/$defs/i18n" }, "items": { "$ref": "#/$defs/tools" } }
          }
        }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "items"],
      "properties": {
        "heading": { "$ref": "#/$defs/i18n" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role", "org", "start", "highlights"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "role": { "$ref": "#/$defs/i18n" },
              "org": { "type": "string" },
              "place": { "$ref": "#/$defs/text" },
              "start": { "$ref": "#/$defs/month" },
              "end": { "oneOf": [{ "$ref": "#/$defs/month" }, { "const": "present" }] },
              "tags": { "type": "array", "items": { "$ref": "#/$defs/i18n" } },
              "highlights": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/i18n" } }
            }
          }
        }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "items", "school_name"],
      "properties": {
        "heading": { "$ref": "#/$defs/i18n" },
        "school_name": { "$ref": "#/$defs/i18n" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "degree", "school", "start", "end", "text"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "degree": { "$ref": "#/$defs/i18n" },
              "school": { "type": "string" },
              "start": { "$ref": "#/$defs/month" },
              "end": { "$ref": "#/$defs/month" },
              "text": { "$ref": "#/$defs/i18n" }
            }
          }
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "paper", "figure", "thesis"],
      "properties": {
        "heading": { "$ref": "#/$defs/i18n" },
        "intro": { "$ref": "#/$defs/i18n" },
        "paper": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "authors", "venue", "short_venue", "location", "dates", "year", "doi", "summary", "bibtex_key"],
          "properties": {
            "title": { "type": "string" },
            "authors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "venue": { "type": "string" },
            "short_venue": { "type": "string" },
            "location": { "$ref": "#/$defs/i18n" },
            "dates": { "$ref": "#/$defs/i18n" },
            "year": { "type": "integer" },
            "pages": { "type": "string" },
            "doi": { "type": "string", "pattern": "^10\\.\\d{4,}/\\S+$" },
            "open_access": { "$ref": "#/$defs/url" },
            "open_access_license": { "type": "string" },
            "bibtex_key": { "type": "string", "pattern": "^[a-z0-9]+$" },
            "summary": { "type": "array", "items": { "$ref": "#/$defs/i18n" } },
            "funding": { "$ref": "#/$defs/i18n" }
          }
        },
        "figure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "caption", "panels"],
          "properties": {
            "title": { "$ref": "#/$defs/i18n" },
            "caption": { "$ref": "#/$defs/i18n" },
            "panels": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "text"],
                "properties": {
                  "id": { "enum": ["flat", "network", "mesh"] },
                  "title": { "$ref": "#/$defs/i18n" },
                  "text": { "$ref": "#/$defs/i18n" }
                }
              }
            }
          }
        },
        "thesis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "institution", "year", "text"],
          "properties": {
            "title": { "type": "string" },
            "institution": { "type": "string" },
            "year": { "type": "integer" },
            "text": { "$ref": "#/$defs/i18n" }
          }
        }
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "featured", "items"],
      "properties": {
        "heading": { "$ref": "#/$defs/i18n" },
        "intro": { "$ref": "#/$defs/i18n" },
        "featured": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "text", "tags"],
          "properties": {
            "title": { "$ref": "#/$defs/i18n" },
            "text": { "$ref": "#/$defs/i18n" },
            "tags": { "$ref": "#/$defs/tools" }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "year", "title", "text", "tags"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "year": { "type": "integer" },
              "title": { "$ref": "#/$defs/text" },
              "text": { "$ref": "#/$defs/i18n" },
              "tags": { "$ref": "#/$defs/tools" },
              "link": { "$ref": "#/$defs/url" }
            }
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certifications_heading", "awards_heading", "certifications", "awards"],
      "properties": {
        "certifications_heading": { "$ref": "#/$defs/i18n" },
        "awards_heading": { "$ref": "#/$defs/i18n" },
        "certifications": { "type": "array", "items": { "$ref": "#/$defs/credential" } },
        "awards": { "type": "array", "items": { "$ref": "#/$defs/credential" } }
      }
    },
    "blog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "title", "lede", "description", "author_bio"],
      "properties": {
        "heading": { "$ref": "#/$defs/i18n" },
        "intro": { "$ref": "#/$defs/i18n" },
        "title": { "$ref": "#/$defs/i18n" },
        "lede": { "$ref": "#/$defs/i18n" },
        "description": { "$ref": "#/$defs/i18n" },
        "author_bio": { "$ref": "#/$defs/i18n" }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "text"],
      "properties": { "heading": { "$ref": "#/$defs/i18n" }, "text": { "$ref": "#/$defs/i18n" } }
    }
  }
}
