{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-trailing-whitespace": "off",
    "long-title": ["error", { "maxlength": 90 }],
    "tel-non-breaking": "off",
    "no-inline-style": "error",
    "require-sri": "off",
    "valid-id": ["error", { "relaxed": true }],
    "doctype-style": "off",
    "prefer-native-element": ["error", { "exclude": ["listbox"] }]
  },
  "elements": ["html5"]
}
