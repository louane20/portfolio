{
  "name": "guerd-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Nawal Guerd's portfolio, typeset as a Linux man page. Built, tested, scanned, signed and deployed by its own pipeline.",
  "license": "MIT",
  "author": "Nawal Guerd <guerd.nawal@gmail.com>",
  "homepage": "https://louane20.github.io/portfolio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louane20/portfolio.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:drafts": "node scripts/build.mjs --drafts",
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/serve.mjs dist 4173",
    "validate:content": "node scripts/validate-content.mjs",
    "lint": "npm run validate:content && npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:links": "node scripts/check-links.mjs dist",
    "test:man": "mandoc -T lint -W warning dist/guerd.1 dist/fr/guerd.1",
    "test:e2e": "playwright test",
    "test": "npm run test:html && npm run test:links && npm run test:e2e",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "marked": "^18.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "globals": "^17.0.0",
    "html-validate": "^11.17.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
